{
  "schema_version": 1,
  "profile": "delivery",
  "harness_version": "0.1.0-rc.7",
  "capabilities": ["git", "node", "python"],
  "plugins": {
    "step-result": {
      "version": "0.1.0",
      "entrypoint": "/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@automation/dsh-plugin-step-result/index.js",
      "inject": ["tools", "systemPrompt"],
      "config": {
        "outputPath": "/output/agent-result.json",
        "maxSummaryLength": 4000
      },
      "mandatory": true
    },
    "gitea": {
      "version": "0.2.0",
      "entrypoint": "/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@automation/dsh-plugin-gitea/index.js",
      "inject": ["tools", "systemPrompt"],
      "config": {
        "baseUrlEnv": "GITEA_BASE_URL",
        "tokenEnv": "GITEA_TOKEN",
        "allowedRepositoriesEnv": "GITEA_ALLOWED_REPOSITORIES"
      },
      "mandatory": false
    },
    "swirl": {
      "version": "0.1.0",
      "entrypoint": "/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@automation/dsh-plugin-swirl/index.js",
      "inject": ["tools", "systemPrompt"],
      "config": {
        "baseUrlEnv": "SWIRL_BASE_URL",
        "usernameEnv": "SWIRL_USERNAME",
        "passwordEnv": "SWIRL_PASSWORD",
        "maxResults": 20
      },
      "mandatory": false
    }
  }
}
