HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_TUI=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<GENERATE_STRONG_PASSWORD>
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<GENERATE_64_HEX_CHARACTERS>
API_SERVER_KEY=<GENERATE_64_HEX_CHARACTERS>

