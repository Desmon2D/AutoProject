OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
LITELLM_MASTER_KEY=<GENERATED_BY_START_LITELLM>
UI_USERNAME=admin
UI_PASSWORD=<GENERATED_BY_START_LITELLM>
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=<GENERATED_BY_START_LITELLM>
DATABASE_URL=postgresql://litellm:<POSTGRES_PASSWORD>@litellm-postgres:5432/litellm
HTTP_PROXY=http://host.docker.internal:10808
HTTPS_PROXY=http://host.docker.internal:10808
NO_PROXY=localhost,127.0.0.1,::1
