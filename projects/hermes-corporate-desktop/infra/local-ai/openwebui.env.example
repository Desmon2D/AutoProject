WEBUI_SECRET_KEY=<GENERATE_64_HEX_CHARACTERS>
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Generated by start-openwebui.ps1. The value contains the MCPO bearer key,
# so keep it only in the ignored .env.openwebui file.
# Generated value contains one OpenAPI connection per corporate MCP, for example:
# TOOL_SERVER_CONNECTIONS=[{"type":"openapi","url":"http://host.docker.internal:8000/dit_git","path":"openapi.json","auth_type":"bearer","key":"<MCPO_API_KEY>","config":{"enable":true},"info":{"id":"dit_git","name":"DIT Git","description":"Read-only GitLab access"}}]

# Generated by start-openwebui.ps1. OpenWebUI talks to the local LiteLLM
# gateway; only LiteLLM receives the upstream OpenRouter credential.
# OPENAI_API_BASE_URL=http://litellm:4000/v1
# OPENAI_API_KEY=<LITELLM_MASTER_KEY>
