# Local Codex CLI mode. No separate API key is required.
LLM_MODE=codex
LLM_MODEL=gpt-5.6-luna

# Local isolated command runner and Codex bridge.
CODE_RUNNER_URL=http://127.0.0.1:3010
CODE_RUNNER_HOST=127.0.0.1
CODE_RUNNER_PORT=3010
CODE_RUNNER_IMAGE=bash:5.2-alpine3.22
CODE_RUNNER_TIMEOUT_MS=10000
CODEX_TIMEOUT_MS=120000
CODE_RUNNER_MAX_OUTPUT_BYTES=65536

# Mock Git and Plane source server started by npm run dev:all.
MCP_MODE=real
MCP_SERVER_URL=http://127.0.0.1:3020/mcp
MOCK_SOURCES_HOST=127.0.0.1
MOCK_SOURCES_PORT=3020

# Scheduler target.
AI_CRON_URL=http://127.0.0.1:3000
