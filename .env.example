# Optional persistent local configuration for Docker Compose.
# Never commit a real key. Use scripts/setup/configure-openrouter.ps1 for hidden input,
# validation, local storage, and an end-to-end smoke check.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AGENT_PROVIDER=openrouter
DEFAULT_AGENT_MODEL=openai/gpt-4.1-nano
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_SECONDS=5
WORKFLOW_RECONCILE_INTERVAL_SECONDS=60

# Required only for Agent Steps that request the native Gitea plugin.
# The URL must be reachable from an agent container.
GITEA_BASE_URL=http://gitea:3000
GITEA_USERNAME=harnes
GITEA_TOKEN=
GITEA_ALLOWED_REPOSITORIES=harnes/payments-api
GITEA_WEBHOOK_SECRET=

# Plane replaces Jira in the local development contour. The repository map is
# JSON from a Plane project id or identifier to a Gitea owner/repository name.
PLANE_BASE_URL=http://plane
PLANE_WEBHOOK_SECRET=
PLANE_READY_STATE_IDS=
PLANE_READY_STATE_NAMES=Ready for development
PLANE_PROJECT_REPOSITORIES={"PAY":"harnes/payments-api"}

# BookStack replaces Confluence in the local development contour. These values
# are passed only to SWIRL when its optional profile is started.
BOOKSTACK_BASE_URL=
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Optional self-hosted SWIRL profile. Keep connection values empty for normal
# low-memory development; scripts/dev/start-dev-swirl.ps1 supplies them when needed.
SWIRL_IMAGE=harnes-swirl:4.5.0.7
SWIRL_BASE_URL=
SWIRL_PUBLIC_URL=http://localhost:8083
SWIRL_USERNAME=
SWIRL_PASSWORD=
# Enable only when testing scheduled searches/subscriptions; it loads another NLP process.
SWIRL_ENABLE_BEAT=false
SWIRL_TIMEOUT_SECONDS=30
SWIRL_MAX_RESULTS=20
SWIRL_SANDBOX_NETWORK=
ARTIFACT_TTL_SECONDS=2592000
ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
# Used only by scripts/dev/start-dev-gitea.ps1 when it must create a scoped token.
GITEA_DEV_PASSWORD=
